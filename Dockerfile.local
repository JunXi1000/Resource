# Local/offline-network build: reuses the prebuilt web/dist on disk and the
# golang base image already present locally, instead of pulling node + distroless
# images that may be unreachable. The frontend assets are embedded into the
# binary via go:embed, so the runtime stage needs nothing else.
#
# Usage:
#   npm --prefix web run build   # ensure web/dist is current
#   docker build -f Dockerfile.local -t safebucket:local .

FROM golang:1.27-bookworm AS builder

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -o /out/safebucket . \
    && mkdir -p /out/data

FROM golang:1.27-bookworm

RUN useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin nonroot

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /out/safebucket ./safebucket
COPY --from=builder --chown=nonroot:nonroot /out/data /app/data

USER nonroot

EXPOSE 8080

CMD ["./safebucket"]
